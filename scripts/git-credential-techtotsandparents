#!/bin/bash
# git-credential-techtotsandparents
# Custom credential helper for techtotsandparents-max repos.
# 
# Reads the PAT from ~/.git-credentials-techtotsandparents
# This file should contain a single line:
#   https://techtotsandparents-max:<PAT>@github.com
#
# Usage (already configured in .git/config):
#   [credential "https://github.com"]
#       helper = /path/to/git-credential-techtotsandparents

ACTION="$1"

CRED_FILE="$HOME/.git-credentials-techtotsandparents"

if [ "$ACTION" = "get" ]; then
  if [ -f "$CRED_FILE" ]; then
    # Read the stored URL and parse it
    URL=$(head -1 "$CRED_FILE")
    # Extract parts: https://user:token@host
    PROTOCOL=$(echo "$URL" | sed 's|://.*||')
    HOST=$(echo "$URL" | sed 's|.*@||')
    USER=$(echo "$URL" | sed 's|.*://||;s|:.*||')
    TOKEN=$(echo "$URL" | sed 's|.*://[^:]*:||;s|@.*||')
    
    echo "protocol=$PROTOCOL"
    echo "host=$HOST"
    echo "username=$USER"
    echo "password=$TOKEN"
  fi
fi

if [ "$ACTION" = "store" ]; then
  # Read the credential from stdin and save it
  while IFS= read -r line; do
    case "$line" in
      protocol=*) PROTOCOL="${line#protocol=}" ;;
      host=*)     HOST="${line#host=}" ;;
      username=*) USER="${line#username=}" ;;
      password=*) TOKEN="${line#password=}" ;;
    esac
  done
  
  if [ -n "$USER" ] && [ -n "$TOKEN" ] && [ "$USER" = "techtotsandparents-max" ]; then
    echo "${PROTOCOL:-https}://${USER}:${TOKEN}@${HOST:-github.com}" > "$CRED_FILE"
    chmod 600 "$CRED_FILE"
  fi
fi
